# Postgres (docker compose)
POSTGRES_DB=monitor_integra
POSTGRES_USER=monitor
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5433

# Conexão do backend (Django lê esta variável em config/settings.py)
DATABASE_URL=postgresql://monitor:troque-esta-senha@localhost:5433/monitor_integra

# Django
DJANGO_SECRET_KEY=gere-uma-chave-com-get_random_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# API
API_PORT=8002

# Harvester
HARVESTER_BASE_URL=http://harvester.exemplo.br:8090
HARVESTER_USER=usuario
HARVESTER_PASSWORD=senha
HARVESTER_TIMEOUT=10
HARVESTER_RETRIES=3
HARVESTER_RETRY_BACKOFF=0.5

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Cache das coletas (segundos)
HARVESTER_CACHE_TTL_NETWORK=86400
HARVESTER_CACHE_TTL_SNAPSHOT=600
HARVESTER_CACHE_TTL_DIAGNOSE=1800
HARVESTER_CACHE_TTL_RECORDS=600
HARVESTER_CACHE_TTL_XML=3600

# Redis: backend do cache. O container publica em 6380 porque a 6379 já é
# usada por outro projeto nesta máquina.
REDIS_PORT=6380
REDIS_MAXMEMORY=256mb
REDIS_URL=redis://localhost:6380/0
