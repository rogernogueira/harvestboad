# Postgres (docker compose)
POSTGRES_DB=harvestboard
POSTGRES_USER=monitor
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5433

# Conexão do backend (Django lê esta variável em config/settings.py)
DATABASE_URL=postgresql://monitor:troque-esta-senha@localhost:5433/harvestboard

# Django
DJANGO_SECRET_KEY=gere-uma-chave-com-get_random_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=hb.comais.uft.edu.br,localhost,127.0.0.1
# Precisa do esquema. O proxy reverso termina o TLS, então é https.
DJANGO_CSRF_TRUSTED_ORIGINS=https://hb.comais.uft.edu.br

# API
API_PORT=8002

# Deploy: porta do host publicada pelo nginx do container `web`. É para cá
# que o proxy reverso (192.168.105.5, hb.comais.uft.edu.br) deve apontar.
WEB_PORT=8085

# Harvester
HARVESTER_BASE_URL=http://harvester.exemplo.br:8090
HARVESTER_USER=usuario
HARVESTER_PASSWORD=senha
HARVESTER_TIMEOUT=10
HARVESTER_RETRIES=3
HARVESTER_RETRY_BACKOFF=0.5

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Cache das coletas (segundos)
HARVESTER_CACHE_TTL_NETWORK=86400
HARVESTER_CACHE_TTL_SNAPSHOT=600
HARVESTER_CACHE_TTL_DIAGNOSE=1800
HARVESTER_CACHE_TTL_RECORDS=600
HARVESTER_CACHE_TTL_XML=3600

# OAI-PMH das origens: resolução do link público de um registro.
OAI_TIMEOUT=5
OAI_MAX_BYTES=2097152
OAI_CACHE_TTL_LINK=86400

# Redis: backend do cache. O container publica em 6380 porque a 6379 já é
# usada por outro projeto nesta máquina.
REDIS_PORT=6380
REDIS_MAXMEMORY=256mb
REDIS_URL=redis://localhost:6380/0
